// Piccolo Firestore rules — staging draft. DO NOT deploy until reviewed.
// Matches existing Firebase admins/{uid} role model and anonymous inquiries.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }
    function validCatalogItem() {
      return request.resource.data.title is string
        && request.resource.data.title.size() >= 2
        && request.resource.data.title.size() <= 160
        && request.resource.data.price is int
        && request.resource.data.price >= 0
        && request.resource.data.active is bool
        && request.resource.data.bookable is bool
        && request.resource.data.sortOrder is int;
    }
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }
    match /products/{id} {
      allow get, list: if isAdmin() || resource.data.active == true;
      allow create, update: if isAdmin() && validCatalogItem();
      allow delete: if false;
    }
    match /combos/{id} {
      allow get, list: if isAdmin() || resource.data.active == true;
      allow create, update: if isAdmin() && validCatalogItem()
        && request.resource.data.componentProductIds is list;
      allow delete: if false;
    }
    match /settings/public {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if false;
    }
    match /inquiries/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'nombre','agasajado','fecha','horario','productValue','espacio',
          'ubicacion','localidad','cp','telefono','extras','productId',
          'userId','source','status','createdAt','displayedPrice',
          'displayedDepositPercentage','termsAccepted','termsVersion'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() >= 2
        && request.resource.data.nombre.size() <= 120
        && request.resource.data.fecha is string
        && request.resource.data.productId is string
        && request.resource.data.telefono is string
        && request.resource.data.telefono.size() <= 40
        && request.resource.data.espacio is string
        && request.resource.data.espacio.size() <= 160
        && request.resource.data.extras is string
        && request.resource.data.extras.size() <= 2000
        && request.resource.data.termsAccepted == true
        && request.resource.data.termsVersion is string
        && request.resource.data.createdAt == request.time
        && request.resource.data.status == 'new';
      allow read: if isAdmin();
      allow update, delete: if false;
    }
    match /reservations/{id} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }
    match /inventoryLocks/{id} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }
    match /dateBlocks/{date} {
      allow read, write: if isAdmin();
    }
    match /productBlocks/{id} {
      allow read, write: if isAdmin();
    }
    match /shortNoticeOverrides/{date} {
      allow read, write: if isAdmin();
    }
    match /paymentEvents/{id} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
