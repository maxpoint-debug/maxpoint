rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function admin() {
      return request.auth != null && request.auth.token.piccoloAdmin == true;
    }
    match /products/{id} {
      allow read: if resource.data.active == true || admin();
      allow write: if admin();
    }
    match /combos/{id} {
      allow read: if resource.data.active == true || admin();
      allow write: if admin();
    }
    match /settings/public {
      allow read: if true;
      allow write: if admin();
    }
    match /inquiries/{id} {
      // Public clients must use a validated server endpoint; no direct public writes.
      allow read, update, delete: if admin();
      allow create: if admin();
    }
    match /reservations/{id} {
      allow read, write: if admin();
    }
    match /inventoryLocks/{id} {
      allow read, write: if admin();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
